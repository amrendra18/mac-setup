#!/bin/sh
# fmt: off
''':'
root=$(cd "$(dirname "$0")/.." && pwd)
if [ ! -x "$root/.local/venv/bin/python" ]; then
  echo "render-template: $root/.local/venv is missing. Run scripts/bootstrap first." >&2
  exit 3
fi
exec "$root/.local/venv/bin/python" -I "$0" "$@"
'''
# fmt: on

import importlib.util
import sys
import textwrap
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[1]
_rules = importlib.util.spec_from_file_location(
    "profile", ROOT / "roles/profile/filter_plugins/profile.py"
)
profile = importlib.util.module_from_spec(_rules)
_rules.loader.exec_module(profile)
SETTINGS = Path("settings/macos")
TEMPLATE = Path("inventory/example/TEMPLATE.yml")
SETTABLE = ("defaults", "command", "dock_apps", "wallpaper", "finder_sidebar", "apps")
TAKES_EFFECT = {
    "live": "at once",
    "dock": "when the Dock restarts",
    "finder": "when Finder restarts",
    "systemuiserver": "when the menu bar restarts",
    "relaunch": "when the app opens again",
    "logout": "at the next login",
}
NEEDS = {
    "full_disk_access": "Full Disk Access for the terminal app",
    "click": "a click at the Mac's screen",
}
SCOPE_WORDS = {"user": "account setting", "machine": "machine setting, needs admin"}
HEADER = f"""\
# Generated by scripts/render-template from {SETTINGS}/. Do not edit this file.
# To change it, edit {SETTINGS}/ and run scripts/render-template.
#
# This file lists every setting mac-setup knows. To use one, copy its line into
# the same section of your profile and remove the "# " in front of it. The value
# after the colon is an example. To give one account its own value, put the line
# under that account's settings. The value unset returns a setting to the macOS default.
# The notes quote research made before mac-setup applied the setting, and "Guess" marks a
# fact nobody measured yet.
"""


class Loader(yaml.SafeLoader):
    pass


def _no_repeated_keys(loader, node):
    pairs = loader.construct_pairs(node, deep=True)
    keys = [key for key, _ in pairs]
    repeated = sorted({str(key) for key in keys if keys.count(key) > 1})
    if repeated:
        raise yaml.constructor.ConstructorError(
            None, None, "repeated key " + ", ".join(repeated), node.start_mark
        )
    return dict(pairs)


Loader.add_constructor(
    yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, _no_repeated_keys
)


def load(settings):
    entries = []
    for path in sorted(settings.glob("*.yml")):
        data = yaml.load(path.read_text(), Loader) or {}
        if not isinstance(data, dict):
            raise ValueError(f"{path.name}: must map setting ids to entries")
        entries += [
            (path.name, setting_id, data[setting_id])
            for setting_id in sorted(data, key=str)
        ]
    return entries


def example(values, default):
    if default != "not measured" and profile._allowed(values, default):
        return default
    if isinstance(values, list):
        return values[0]
    kind = values["type"]
    if kind in ("int", "float"):
        return values["min"]
    return {
        "bool": False,
        "text": "unset",
        "bundle_ids": [],
        "paths": [],
        "list": [],
        "catalog_ids": [],
    }[kind]


def _text(value):
    return str(value).lower() if isinstance(value, bool) else str(value)


def _flow(value):
    return (
        yaml.safe_dump(value, default_flow_style=True, width=1000)
        .removesuffix("\n...\n")
        .strip()
    )


def describe(values):
    if isinstance(values, list):
        return ", ".join(map(profile._choice_text, values))
    kind = values["type"]
    if kind in ("int", "float"):
        number = "a whole number" if kind == "int" else "a number"
        return f"{number} from {values['min']} to {values['max']}"
    if kind == "text":
        return f"text that matches {values['pattern']}"
    if kind == "list":
        return "a list of any of " + ", ".join(
            map(profile._choice_text, values["choices"])
        )
    return {
        "bool": "true or false",
        "bundle_ids": "a list of app bundle ids, in Dock order",
        "paths": 'a list of folder paths that start with / or "~", other than / itself, in order',
        "catalog_ids": "a list of app ids from apps/macos.yml",
    }[kind]


def _proven(proven_on):
    if not proven_on:
        return "not yet"
    return ", ".join(
        f"macOS {version} ({day})" for version, day in sorted(proven_on.items())
    )


def _facts(entry):
    if entry["route"] == "by_hand":
        return [
            ("Scope", SCOPE_WORDS[entry["scope"]]),
            ("Values", describe(entry["values"])),
            ("Where", entry["where"]),
        ]
    if entry["route"] == "not_yet":
        return [
            ("Scope", SCOPE_WORDS[entry["scope"]]),
            ("Not yet because", entry["not_yet_reason"]),
        ]
    facts = [
        ("Values", describe(entry["values"])),
        ("macOS default", _text(entry["macos_default"])),
        ("Takes effect", TAKES_EFFECT[entry["takes_effect"]]),
        ("Needs", ", ".join(NEEDS[need] for need in entry["needs"]) or "nothing extra"),
        ("Proven on", _proven(entry["proven_on"])),
    ]
    if entry["lockout_risk"]:
        facts.append(
            (
                "Warning",
                "can lock you out of this Mac; it needs allow_lockout_risk: true",
            )
        )
    return facts


def _wrap(prefix, text):
    return textwrap.wrap(
        text,
        100,
        initial_indent=prefix,
        subsequent_indent=prefix + "  ",
        break_long_words=False,
        break_on_hyphens=False,
    )


def _entry(prefix, setting_id, entry):
    if entry["route"] in SETTABLE:
        head = f"{prefix}{setting_id}: {_flow(example(entry['values'], entry['macos_default']))}"
    else:
        head = f"{prefix}{setting_id}"
    lines = [head, *_wrap(prefix + "  ", entry["summary"])]
    for label, value in _facts(entry):
        lines += _wrap(prefix + "  ", f"{label}: {value}")
    if entry.get("notes"):
        lines += _wrap(prefix + "  ", f"Note: {entry['notes']}")
    return lines


def _block(prefix, entries):
    lines, area = [], None
    for file_name, setting_id, entry in entries:
        if file_name != area:
            area = file_name
            lines += ["", f"{prefix}Area: {Path(file_name).stem}"]
        lines += ["", *_entry(prefix, setting_id, entry)]
    return lines or ["", f"{prefix}None yet."]


def render(settings):
    entries = load(settings)
    blocks = [
        (
            "# Account settings. Each listed account, and the account that runs mac-setup, gets these.",
            "default_settings:",
            "  # ",
            lambda e: e["scope"] == "user" and e["route"] in SETTABLE,
        ),
        (
            "# Machine settings. They change the whole Mac and need an admin account.",
            "machine_settings:",
            "  # ",
            lambda e: e["scope"] == "machine" and e["route"] in SETTABLE,
        ),
        (
            "# Click-only settings. No script can set these. List one under default_settings or"
            "\n# machine_settings, as its scope says, and playbooks/by-hand.yml walks you through it.",
            None,
            "# ",
            lambda e: e["route"] == "by_hand",
        ),
        (
            "# Not yet supported. mac-setup knows these settings but cannot set them yet.",
            None,
            "# ",
            lambda e: e["route"] == "not_yet",
        ),
    ]
    lines = HEADER.splitlines()
    for title, key, prefix, chosen in blocks:
        lines += ["", title, *([key] if key else [])]
        lines += _block(prefix, [item for item in entries if chosen(item[2])])
    return "\n".join(lines) + "\n"


def main():
    if sys.argv[1:] in (["-h"], ["--help"]):
        print(
            f"usage: scripts/render-template\nwrites {TEMPLATE} from {SETTINGS}/*.yml\n"
            "exit codes: 0 written, 2 usage error, 3 .local/venv is missing"
        )
        return 0
    if sys.argv[1:]:
        print("usage: scripts/render-template", file=sys.stderr)
        return 2
    text = render(ROOT / SETTINGS)
    (ROOT / TEMPLATE).write_text(text)
    print(f"wrote {TEMPLATE}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
