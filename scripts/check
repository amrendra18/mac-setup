#!/bin/bash
set -uo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root" || exit 2
bin=$root/.local/venv/bin
words=$root/.local/private-words.txt
export ANSIBLE_CONFIG=$root/ansible.cfg ANSIBLE_NOCOLOR=1 ANSIBLE_FORCE_COLOR=0 ANSIBLE_STDOUT_CALLBACK=ansible.builtin.default

usage() {
  cat <<'EOF'
usage: scripts/check [fast|full]

fast  yamllint, playbook syntax, Python unit tests in tests/modules/ and tests/harness/, every broken
      test input in tests/inputs/ (each must stop in the profile check with exit 2
      and changed=0, run with --check, and print one problem line per
      "# expect: SUBJECT" line in the input, each line starting "SUBJECT: "),
      the structure rules, the private-word scan and gitleaks. It changes no
      settings.
full  fast, then the reference test tests/test_reference.py, black --check on the
      Python files, and ansible-lint when requirements/dev.txt pins it.

Needs scripts/bootstrap's .local/venv, the dev tools from requirements/dev.txt in it,
gitleaks in .local/bin or on PATH, and the ignored word list .local/private-words.txt
(one word per line).
Install the dev tools from their pinned direct URLs, without the PyPI index:
  mkdir -p .local/wheels && (cd .local/wheels && xargs -n 1 curl --fail --silent --show-error --location --remote-name <../../requirements/dev-urls.txt)
  .local/venv/bin/python -I -m pip install --isolated --no-index --find-links .local/wheels --no-deps --require-hashes --only-binary :all: -r requirements/dev.txt

exit codes: 0 every check held, 1 a check failed, 2 usage error
EOF
}

case "$#:${1:-fast}" in
  0:fast | 1:fast | 1:full) level=${1:-fast} ;;
  1:-h | 1:--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

work=$(mktemp -d "${TMPDIR:-/tmp}/mac-setup-check.XXXXXX") || exit 2
trap 'rm -rf "$work"' EXIT
failed=()

step() {
  local name=$1 out
  shift
  if out=$("$@" 2>&1); then
    printf 'ok    %s\n' "$name"
    [ -z "$out" ] || printf '%s\n' "$out" | sed 's/^/      /'
  else
    printf 'FAIL  %s\n' "$name"
    printf '%s\n' "$out" | sed 's/^/      /'
    failed+=("$name")
  fi
}

need() {
  local missing=0 path
  for path in "$@"; do
    [ -e "$path" ] || { echo "missing $path"; missing=1; }
  done
  return $missing
}

candidates() {
  git ls-files -z --cached --others --exclude-standard | while IFS= read -r -d '' f; do
    [ -f "$f" ] && printf '%s\0' "$f"
  done
}

yaml_lint() {
  need "$bin/yamllint" .yamllint || { echo "install the dev tools, see scripts/check --help"; return 1; }
  candidates | grep -zE '\.(yml|yaml)$|^\.yamllint$' | xargs -0 "$bin/yamllint" --strict --config-file .yamllint
}

syntax() {
  need "$bin/ansible-playbook" ansible.cfg inventory/example || return 1
  local playbook found=0 bad=0
  for playbook in playbooks/*.yml; do
    [ -f "$playbook" ] || continue
    found=1
    "$bin/ansible-playbook" -i inventory/example --syntax-check "$playbook" >"$work/syntax.txt" 2>&1 || { cat "$work/syntax.txt"; bad=1; }
  done
  [ $found = 1 ] || { echo "no playbooks/*.yml"; return 1; }
  return $bad
}

unit_tests() {
  "$bin/python" -I -m unittest discover -s tests/modules -t tests/modules -p 'test_*.py' 2>&1 &&
    "$bin/python" -I -m unittest discover -s tests/harness -t tests/harness -p 'test_*.py' 2>&1
}

input_check='
import re, sys, textwrap
from collections import Counter
import yaml

name, code = sys.argv[1], int(sys.argv[3])
out = open(sys.argv[2]).read().splitlines()
expected = Counter(re.findall(r"^# expect: (.+?) *$", open(name).read(), re.M))
recap = next((line for line in reversed(out) if re.match(r"example-mac +:", line)), "")
task, problems = "", []
for i, line in enumerate(out):
    if line.startswith("TASK ["):
        task = line.rstrip(" *")
    elif line.startswith("fatal: [example-mac]"):
        end = out.index("", i) if "" in out[i:] else len(out)
        result = yaml.safe_load(textwrap.dedent("\n".join(out[i + 1 : end])))
        problems = str(result.get("msg", "")).splitlines()
        break
got = Counter(line.split(": ", 1)[0] for line in problems)
faults = []
if code != 2:
    faults.append(f"exit {code}, expected 2")
if " changed=0 " not in recap:
    faults.append(f"recap {recap!r}, expected changed=0")
if not task.startswith("TASK [profile : "):
    faults.append(f"failed task {task!r}, expected one in the profile role")
if not expected:
    faults.append("no # expect: lines")
if got != expected or any(": " not in line for line in problems):
    faults.append(f"problem lines {problems}, expected one per subject {sorted(expected.elements())}")
if faults:
    sys.exit(f"{name}: " + "; ".join(faults))
print(f"{name} stopped at exit 2 in {task}, {len(problems)} problem lines, one per expected subject")
'

test_inputs() {
  need "$bin/ansible-playbook" "$bin/python" ansible.cfg playbooks/site.yml || return 1
  local input n=0 bad=0 out code
  mkdir -p "$work/inputs-inventory" && cp inventory/example/hosts.yml "$work/inputs-inventory/hosts.yml"
  while IFS= read -r -d '' input; do
    n=$((n + 1))
    out=$work/input-$n.txt
    "$bin/ansible-playbook" -i "$work/inputs-inventory" -e @"$input" playbooks/site.yml --check >"$out" 2>&1
    code=$?
    "$bin/python" -I -c "$input_check" "$input" "$out" "$code" 2>&1 || { sed 's/^/  /' "$out"; bad=1; }
  done < <(find tests/inputs -type f \( -name '*.yml' -o -name '*.yaml' \) -print0 | sort -z)
  [ $n -gt 0 ] || { echo "no test inputs in tests/inputs/"; return 1; }
  return $bad
}

structure() {
  local bad=0 hits
  if [ -d roles ]; then
    hits=$(grep -rnw sudo roles) && { echo "sudo inside roles/:"; echo "$hits"; bad=1; }
  fi
  hits=$(candidates | grep -zvE '\.md$|^scripts/check$' | xargs -0 grep -nIiE 'tccutil +reset|TCC\.db|csrutil +disable') &&
    { echo "privacy database or System Integrity Protection change:"; echo "$hits"; bad=1; }
  need "$bin/python" || return 1
  candidates | grep -zE '^(roles|playbooks|inventory)/.*\.ya?ml$' | "$bin/python" -I -c '
import sys, yaml

class Loader(yaml.SafeLoader):
    pass

Loader.add_multi_constructor("!", lambda loader, suffix, node: None)

def keys(node, path):
    if isinstance(node, dict):
        for key, value in node.items():
            yield key, path, value
            yield from keys(value, path + [key])
    elif isinstance(node, list):
        for i, value in enumerate(node):
            yield from keys(value, path + [i])

bad = 0
for name in sys.stdin.read().split("\0"):
    if not name:
        continue
    for key, path, value in keys(yaml.load(open(name), Loader), []):
        in_role = name.startswith("roles/")
        if (key == "ansible_become" and value is not False) or (
            key == "become" and (in_role or (value is not False and (name, path) != ("playbooks/site.yml", [1])))
        ):
            print(f"{name}: {key}: {value} at {path}; admin rights belong only in play 2 of playbooks/site.yml")
            bad = 1
sys.exit(bad)
' || bad=1
  return $bad
}

private_words() {
  need "$words" || { echo "create $words with one private word per line, such as your machine and account names; git ignores it"; return 1; }
  grep -vE '^[[:space:]]*(#|$)' "$words" >"$work/words.txt"
  [ -s "$work/words.txt" ] || { echo "$words holds no words"; return 1; }
  local hits
  if hits=$(candidates | xargs -0 grep -nIiF -f "$work/words.txt" | cut -d: -f1-2); then
    echo "private words at these lines (the words are not printed):"
    echo "$hits"
    return 1
  fi
}

secrets() {
  local gitleaks=$root/.local/bin/gitleaks
  [ -x "$gitleaks" ] || gitleaks=$(command -v gitleaks) || { echo "gitleaks is not in .local/bin or on PATH"; return 1; }
  mkdir -p "$work/tree"
  candidates | rsync -a --from0 --files-from=- . "$work/tree/"
  "$gitleaks" dir --no-banner --redact --verbose --log-level warn "$work/tree" || return 1
  if git rev-parse --verify --quiet HEAD >/dev/null; then
    "$gitleaks" git --no-banner --redact --verbose --log-level warn . || return 1
  fi
}

reference_test() {
  "$bin/python" -I tests/test_reference.py
}

ansible_lint() {
  need "$bin/ansible-lint" || { echo "install the dev tools, see scripts/check --help"; return 1; }
  PATH=$bin:$PATH "$bin/ansible-lint" --offline --strict playbooks roles
}

python_files() {
  local f
  while IFS= read -r -d '' f; do
    case $f in
      *.py) printf '%s\0' "$f" ;;
      scripts/*) head -3 "$f" | grep -q "^'''" && printf '%s\0' "$f" ;;
    esac
  done
}

python_format() {
  need "$bin/black" || { echo "install the dev tools, see scripts/check --help"; return 1; }
  local out
  out=$(candidates | python_files | xargs -0 "$bin/black" --check 2>&1) && return
  printf '%s\n' "$out" | grep '^would reformat'
  echo "format them with .local/venv/bin/black"
  return 1
}

step yamllint yaml_lint
step "playbook syntax" syntax
if [ -n "$(find tests/modules -name 'test_*.py' 2>/dev/null)" ]; then
  step "unit tests" unit_tests
else
  echo "skip  unit tests: tests/modules/ has none yet"
fi
step "broken test inputs" test_inputs
step "structure rules" structure
step "private words" private_words
step "secret scan" secrets
if [ "$level" = full ]; then
  step "reference test" reference_test
  step "python format" python_format
  if grep -qi '^ansible-lint==' requirements/dev.txt 2>/dev/null; then
    step ansible-lint ansible_lint
  else
    echo "skip  ansible-lint: requirements/dev.txt does not pin it"
  fi
fi

if [ ${#failed[@]} -eq 0 ]; then
  echo "check $level: every check held"
  exit 0
fi
echo "check $level: ${#failed[@]} failed: ${failed[*]}"
exit 1
