#!/bin/sh
usage='usage: scripts/vault-password
Ansible runs it through ansible.cfg. It takes no arguments and prints the vault password
from DOT_HOME/mac-setup/vault-password (DOT_HOME defaults to ~/.dot) to a pipe.
exit codes: 0 printed, 1 ansible-vault started without a password file, 2 usage error or a terminal'
case $#:${1:-} in
  0:) ;;
  1:-h | 1:--help) echo "$usage"; exit 0 ;;
  *) echo "$usage" >&2; exit 2 ;;
esac
if [ -t 1 ]; then
  echo "vault-password: Ansible runs this script; it prints the vault password, so it refuses a terminal" >&2
  exit 2
fi
# Ansible refuses an empty password, so without a usable file this prints a random
# one: runs without vault files work, and a vault file fails to decrypt.
file=${DOT_HOME:-$HOME/.dot}/mac-setup/vault-password
if [ -f "$file" ] && [ ! -L "$file" ] && [ -O "$file" ] && [ "$(stat -f %Lp "$file")" = 600 ]; then
  exec cat "$file"
fi
if [ -e "$file" ] || [ -L "$file" ]; then
  echo "vault-password: ignoring $file; it must be a file you own with mode 600 (chmod 600 $file)" >&2
fi
case $(ps -o command= -p "$PPID" 2>/dev/null) in
  *ansible-vault*)
    echo "vault-password: store your vault password in $file (mode 600) before using ansible-vault" >&2
    exit 1
    ;;
esac
od -An -N32 -tx1 /dev/urandom | tr -d ' \n'
