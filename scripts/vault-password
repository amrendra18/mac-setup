#!/bin/sh
# Ansible refuses an empty password, so without a usable file this prints a random
# one: runs without vault files work, and a vault file fails to decrypt.
file=${DOT_HOME:-$HOME/.dot}/mac-setup/vault-password
if [ -f "$file" ] && [ ! -L "$file" ] && [ -O "$file" ] && [ "$(stat -f %Lp "$file")" = 600 ]; then
  exec cat "$file"
fi
if [ -e "$file" ] || [ -L "$file" ]; then
  echo "vault-password: ignoring $file; it must be a file you own with mode 600 (chmod 600 $file)" >&2
fi
case $(ps -o command= -p "$PPID" 2>/dev/null) in
  *ansible-vault*)
    echo "vault-password: store your vault password in $file (mode 600) before using ansible-vault" >&2
    exit 1
    ;;
esac
od -An -N32 -tx1 /dev/urandom | tr -d ' \n'
